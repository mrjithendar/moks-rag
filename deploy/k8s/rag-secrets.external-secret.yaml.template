# Template for External Secrets Operator (e.g. Vault ClusterSecretStore in hetzner k3s).
# Copy to `rag-secrets.external-secret.yaml`, set your ClusterSecretStore & secret path,
# and add it to `deploy/k8s/kustomization.yaml`.
# LiteLLM's DATABASE_URL is not here: k8s-deployments' Terraform writes Secret rag/postgres-db-credentials.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: rag-secrets
  namespace: rag
  labels:
    app.kubernetes.io/part-of: rag
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: vault-backend
    kind: ClusterSecretStore
  target:
    name: rag-secrets
    creationPolicy: Owner
  data:
    - secretKey: ANTHROPIC_API_KEY
      remoteRef:
        key: secret/data/rag
        property: ANTHROPIC_API_KEY
    - secretKey: LITELLM_MASTER_KEY
      remoteRef:
        key: secret/data/rag
        property: LITELLM_MASTER_KEY
    # LiteLLM's database encryption key: never change it once LiteLLM has stored anything (README "LiteLLM Admin UI").
    - secretKey: LITELLM_SALT_KEY
      remoteRef:
        key: secret/data/rag
        property: LITELLM_SALT_KEY
    - secretKey: LITELLM_UI_USERNAME
      remoteRef:
        key: secret/data/rag
        property: LITELLM_UI_USERNAME
    - secretKey: LITELLM_UI_PASSWORD
      remoteRef:
        key: secret/data/rag
        property: LITELLM_UI_PASSWORD
    - secretKey: QDRANT_API_KEY
      remoteRef:
        key: secret/data/rag
        property: QDRANT_API_KEY
    - secretKey: RAG_BEARER_TOKEN
      remoteRef:
        key: secret/data/rag
        property: RAG_BEARER_TOKEN
    - secretKey: WEBUI_SECRET_KEY
      remoteRef:
        key: secret/data/rag
        property: WEBUI_SECRET_KEY
