# Template for Bitnami SealedSecret (never commit plaintext Kubernetes Secrets!).
#
# Generate the real encrypted manifest locally and commit `rag-secrets.sealed-secret.yaml`:
#   kubectl create secret generic rag-secrets \
#     --namespace rag \
#     --from-literal=QDRANT_API_KEY="$(openssl rand -hex 32)" \
#     --from-literal=ANTHROPIC_API_KEY="sk-ant-..." \
#     --from-literal=LITELLM_MASTER_KEY="sk-litellm-$(openssl rand -hex 24)" \
#     --from-literal=LITELLM_SALT_KEY="sk-$(openssl rand -hex 32)" \
#     --from-literal=LITELLM_UI_USERNAME="<your admin name, not admin>" \
#     --from-literal=LITELLM_UI_PASSWORD="$(openssl rand -hex 24)" \
#     --from-literal=RAG_BEARER_TOKEN="$(openssl rand -hex 32)" \
#     --from-literal=WEBUI_SECRET_KEY="$(openssl rand -hex 32)" \
#     --dry-run=client -o yaml \
#   | kubeseal --format yaml > deploy/k8s/rag-secrets.sealed-secret.yaml
# LITELLM_SALT_KEY encrypts what LiteLLM stores in PostgreSQL: never change it afterwards (README "LiteLLM Admin UI").
# LiteLLM's DATABASE_URL is not here: k8s-deployments' Terraform writes Secret rag/postgres-db-credentials.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: rag-secrets
  namespace: rag
  labels:
    app.kubernetes.io/part-of: rag
spec:
  encryptedData:
    ANTHROPIC_API_KEY: REPLACE_WITH_KUBESEAL_CIPHERTEXT
    LITELLM_MASTER_KEY: REPLACE_WITH_KUBESEAL_CIPHERTEXT
    LITELLM_SALT_KEY: REPLACE_WITH_KUBESEAL_CIPHERTEXT
    LITELLM_UI_USERNAME: REPLACE_WITH_KUBESEAL_CIPHERTEXT
    LITELLM_UI_PASSWORD: REPLACE_WITH_KUBESEAL_CIPHERTEXT
    QDRANT_API_KEY: REPLACE_WITH_KUBESEAL_CIPHERTEXT
    RAG_BEARER_TOKEN: REPLACE_WITH_KUBESEAL_CIPHERTEXT
    WEBUI_SECRET_KEY: REPLACE_WITH_KUBESEAL_CIPHERTEXT
  template:
    metadata:
      name: rag-secrets
      namespace: rag
      labels:
        app.kubernetes.io/part-of: rag
    type: Opaque
